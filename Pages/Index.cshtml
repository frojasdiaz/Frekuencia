@page
@model IndexModel
@{ ViewData["Title"]="Tu radio para todos los días"; ViewData["LandingPage"]=true; }
<div class="site">
<header class="header wrap"><a class="logo" href="#"><span class="logo-wave"><i></i><i></i><i></i><i></i><i></i></span><strong>Frekuencia</strong></a><nav><a href="#radio">Radio</a><a href="#momentos">Momentos</a><a href="#chat">Chat</a><a href="#nosotros">Nosotros</a></nav><a class="header-live" href="#radio"><i></i> Estamos sonando</a></header>
<main>
<section class="hero wrap" id="radio"><div class="hero-copy"><span class="hello">HOLA, SOMOS FREKUENCIA 👋</span><h1>La música que te acompaña, <em>sin complicaciones.</em></h1><p>Una radio online desde Coquimbo. Ponemos música todo el día y, cuando coincidimos, prendemos los micrófonos para conversar con amigos e invitados.</p><div class="hero-buttons"><button id="heroPlay"><b>▶</b><span><small>ESCUCHAR AHORA</small>Frekuencia en vivo</span></button><a href="#chat">Entrar al chat →</a></div><div class="trust"><span>F</span><span>C</span><p><strong>Hecha por personas</strong><small>No por un algoritmo.</small></p></div></div>
<div class="now-card"><div class="cover"><span class="live-tag"><i></i> EN DIRECTO</span><div class="sun"><b>F</b><small>96.8 ONLINE</small></div><div class="floating-note">♪</div></div><div class="song"><small>SONANDO AHORA</small><h2>Midnight Signals</h2><p>Neon Coast</p><div class="timeline"><i></i></div><div class="controls"><button id="heart">♡ <span>24</span></button><button id="playButton" class="main-control"><span class="play-symbol">▶</span><span class="pause-symbol">Ⅱ</span></button><label>🔊 <input type="range" min="0" max="100" value="75"/></label></div></div><div class="next"><small>A CONTINUACIÓN</small><span><b>NS</b><i><strong>Night Swim</strong>Polar Youth</i></span></div></div></section>
<section class="status-bar"><div class="wrap"><span><i></i> SEÑAL ACTIVA</span><div class="wave">@for(var i=0;i<36;i++){<i style="--n:@i"></i>}</div><p><b>128</b> personas escuchando contigo</p></div></section>
<section class="moments wrap" id="momentos"><header><span class="eyebrow">UNA RADIO PARA CADA MOMENTO</span><h2>¿Qué necesitas escuchar hoy?</h2></header><div class="moment-grid"><article class="morning"><span>☀</span><small>06:00 — 12:00</small><h3>Partir suave</h3><p>Indie, pop y canciones para comenzar el día sin apuro.</p><button>Escuchar selección →</button></article><article class="day"><span>◉</span><small>12:00 — 21:00</small><h3>Subir la energía</h3><p>Temas nuevos, clásicos y esa canción que no sabías que necesitabas.</p><button>Estás aquí <i></i></button></article><article class="night"><span>☾</span><small>21:00 — 06:00</small><h3>Bajar las luces</h3><p>Electrónica suave y música nocturna para cerrar el día.</p><button>Ver programación →</button></article></div></section>
<section class="community" id="chat"><div class="wrap community-grid"><div class="community-copy"><span class="eyebrow">LA GENTE DE FREKUENCIA</span><h2>No tienes que escuchar a solas.</h2><p>Comenta lo que suena, saluda desde donde estés o cuéntanos qué canción debería venir después.</p><div class="reaction"><small>¿CÓMO ESTÁ LA VIBRA?</small><button data-vibe>🔥 <b>18</b></button><button data-vibe>💜 <b>13</b></button><button data-vibe>🌊 <b>10</b></button></div></div><div class="chat-box"><header><div><i></i><b>Chat en vivo</b></div><span><b id="onlineCount">34</b> conectados</span></header><div class="messages" id="chatMessages"><article class="msg"><span class="avatar pink">C</span><div><small>Camila · ahora</small><p>Esta canción está demasiado buena ✨</p></div></article><article class="msg me"><div><small>Pipe · ahora</small><p>Perfecta para trabajar jajaja</p></div><span class="avatar blue">P</span></article><article class="msg"><span class="avatar green">D</span><div><small>Diego · ahora</small><p>Saludos desde Coquimbo 🌊</p></div></article><article class="msg me"><div><small>Sofía · ahora</small><p>¿Cuándo hacen programa con invitados? 👀</p></div><span class="avatar violet">S</span></article></div><form id="chatForm"><input id="chatInput" maxlength="100" placeholder="Escribe algo buena onda..."/><button>Enviar</button></form><small class="demo">Demo visual · tu mensaje queda en este dispositivo</small></div></div></section>
<section class="special wrap"><div><span class="eyebrow">CUANDO PRENDEMOS LOS MICRÓFONOS</span><h2>Fuera de Frekuencia</h2><p>Felipe, amigos e invitados conversando de música, historias, tecnología y cualquier cosa que aparezca. Sin calendario rígido y sin guion.</p><div class="hosts"><span>F</span><span>C</span><b>Próxima transmisión<br/><small>Muy pronto · Síguenos para enterarte</small></b></div></div><aside><b>“</b><p>Dos amigos, buena música<br/>y algo que conversar.</p><span>— Ese es todo el plan.</span></aside></section>
<section class="about wrap" id="nosotros"><span>DESDE COQUIMBO · CHILE</span><h2>Música elegida por personas.<br/><em>Para personas.</em></h2><p>Frekuencia está recién comenzando. Queremos construir una radio cercana, entretenida y con espacio para que la gente participe desde el primer día.</p><div><a href="#">◎ Instagram</a><a href="#">♪ TikTok</a><a href="#chat"># Abrir el chat</a></div></section>
</main><footer class="footer wrap"><a class="logo" href="#"><span class="logo-wave"><i></i><i></i><i></i><i></i><i></i></span><strong>Frekuencia</strong></a><p>Estamos en la misma Frekuencia.</p><span>© 2026 · Coquimbo, Chile</span></footer>
<div class="mobile-player"><button id="mobilePlay">▶</button><div><small>SONANDO AHORA</small><b>Midnight Signals</b><span>Neon Coast</span></div><div class="mini-wave"><i></i><i></i><i></i><i></i></div></div>
</div>
@section Scripts{<script>(()=>{const p=document.getElementById('playButton'),h=document.getElementById('heroPlay'),m=document.getElementById('mobilePlay');const toggle=()=>{const on=!p.classList.contains('on');p.classList.toggle('on',on);h.classList.toggle('on',on);m.textContent=on?'Ⅱ':'▶';document.querySelector('.site').classList.toggle('playing',on)};[p,h,m].forEach(x=>x?.addEventListener('click',toggle));document.getElementById('heart')?.addEventListener('click',e=>{const b=e.currentTarget,on=b.classList.toggle('liked');b.firstChild.textContent=on?'♥ ':'♡ ';const n=b.querySelector('span');n.textContent=+n.textContent+(on?1:-1)});document.querySelectorAll('[data-vibe]').forEach(b=>b.onclick=()=>{b.querySelector('b').textContent=+b.querySelector('b').textContent+1;b.classList.add('pop');setTimeout(()=>b.classList.remove('pop'),300)});const box=document.getElementById('chatMessages'),form=document.getElementById('chatForm'),input=document.getElementById('chatInput');const add=(name,text,letter,color,me=false)=>{const x=box.querySelector('.msg').cloneNode(true);x.className='msg fresh'+(me?' me':'');const a=x.querySelector('.avatar');a.className='avatar '+color;a.textContent=letter;x.querySelector('small').textContent=name+' · ahora';x.querySelector('p').textContent=text;me?x.append(a):x.prepend(a);box.append(x);while(box.children.length>7)box.firstElementChild.remove();box.scrollTo({top:box.scrollHeight,behavior:'smooth'})};form.onsubmit=e=>{e.preventDefault();const t=input.value.trim();if(t){add('Tú',t,'T','orange',true);input.value=''}};const demo=[['Vale','Esta selección está preciosa 💜','V','pink'],['Nico','¿Cuál viene ahora?','N','blue'],['Anto','Escuchando desde La Serena 🙌','A','green']];let i=0;setInterval(()=>{if(!document.hidden){add(...demo[i++%demo.length],i%2===0);document.getElementById('onlineCount').textContent=32+Math.floor(Math.random()*7)}},10000)})();</script>}
