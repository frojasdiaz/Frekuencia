@page
@model IndexModel
@{
    ViewData["Title"] = "Música todo el día, conversaciones cuando coincidimos";
    ViewData["LandingPage"] = true;

    // Contenido principal: cambia estos valores cuando exista un programa especial en vivo.
    const string programaActual = "Fuera de Frekuencia";
    const string conductorPrincipal = "Felipe";
    const string segundoConductor = "Co-host";
}

<div class="radio-site">
    <header class="site-header">
        <div class="shell header-inner">
            <a class="brand" href="#inicio" aria-label="Frekuencia, inicio">
                <span class="brand-symbol" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
                <span>Frekuencia</span>
            </a>
            <nav aria-label="Navegación principal">
                <a class="active" href="#inicio">Inicio</a>
                <a href="#programacion">Programación</a>
                <a href="#nosotros">Nosotros</a>
            </nav>
            <div class="header-socials"><a href="#" aria-label="Instagram">◎</a><a href="#" aria-label="TikTok">♪</a></div>
            <button class="menu-button" type="button" aria-label="Abrir navegación"><span></span><span></span></button>
        </div>
    </header>

    <main id="inicio">
        <section class="on-air shell">
            <div class="hero-intro">
                <p class="pretitle"><span class="live-dot"></span> Señal online · 24/7 desde Coquimbo</p>
                <h1>Estamos en la misma <em>Frekuencia.</em></h1>
                <p>Música para acompañarte todo el día. Y cuando prendemos los micrófonos: invitados, historias y conversaciones sin guion.</p>
            </div>

            <div class="studio-grid">
                <article class="radio-card">
                    <div class="radio-visual">
                        <div class="orb orb-one"></div><div class="orb orb-two"></div>
                        <div class="live-badge"><span class="live-dot"></span> Música en vivo</div>
                        <div class="listeners"><svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg> <span id="listenerCount">128</span> escuchando</div>
                        <div class="frequency-lines" aria-hidden="true">@for (var i = 0; i < 48; i++) { <i style="--bar:@i"></i> }</div>
                        <div class="show-art"><span>F.</span><small>NON STOP<br />MUSIC</small></div>
                        <p class="signal-label">Señal en directo <span></span> 96.8 ONLINE</p>
                    </div>
                    <div class="player-info">
                        <div class="now-playing"><span>Sonando ahora · Música continua</span><h2 id="songTitle">Midnight Signals</h2><p id="songArtist">Neon Coast · Frekuencia Selection</p></div>
                        <div class="music-meta"><span><i>♫</i> Indie pop</span><span><i>◷</i> 03:24</span><button id="likeSong" type="button" aria-label="Me gusta esta canción">♡ <b id="likeCount">24</b></button></div>
                        <div class="player-controls">
                            <button id="playButton" class="play-button" type="button" aria-label="Reproducir radio" aria-pressed="false"><svg class="play-icon" viewBox="0 0 24 24"><path d="m8 5 11 7-11 7Z"/></svg><svg class="pause-icon" viewBox="0 0 24 24"><path d="M7 5h4v14H7zM14 5h4v14h-4z"/></svg></button>
                            <div class="track"><span id="playerStatus">Toca play y entra en Frekuencia</span><div class="track-line"><i></i></div></div>
                            <div class="volume"><svg viewBox="0 0 24 24"><path d="M11 5 6 9H2v6h4l5 4zM15.5 8.5a5 5 0 0 1 0 7M18 6a8 8 0 0 1 0 12"/></svg><input type="range" min="0" max="100" value="72" aria-label="Volumen" /></div>
                        </div>
                        <div class="up-next"><span>Después</span><div><i>NS</i><p><strong>Night Swim</strong><small>Polar Youth</small></p></div><div><i>SL</i><p><strong>Slow Lights</strong><small>Ambar</small></p></div></div>
                    </div>
                </article>

                <aside class="chat-card" aria-label="Chat en vivo">
                    <div class="chat-header"><div><span class="chat-icon">#</span><p><strong>La cabina</strong><small><i></i> <span id="onlineCount">34</span> personas conectadas</small></p></div><button type="button" aria-label="Opciones">•••</button></div>
                    <div id="chatMessages" class="chat-messages" aria-live="polite">
                        <div class="system-message"><span></span> Estás escuchando Frekuencia Non Stop</div>
                        <div class="message"><span class="avatar av-camila">C</span><p><strong>Camila <time>Ahora</time></strong>Esta canción está demasiado buena 💜</p></div>
                        <div class="message"><span class="avatar av-pipe">P</span><p><strong>Pipe <time>Ahora</time></strong>Ideal para trabajar jajaja</p></div>
                        <div class="message"><span class="avatar av-matias">M</span><p><strong>Matías <time>Ahora</time></strong>¿Cómo se llama la que sonó antes?</p></div>
                        <div class="message"><span class="avatar av-sofia">S</span><p><strong>Sofía <time>Ahora</time></strong>Necesito invitado nuevo pronto 👀</p></div>
                        <div class="message"><span class="avatar av-diego">D</span><p><strong>Diego <time>Ahora</time></strong>Escuchando desde Coquimbo 🌊</p></div>
                    </div>
                    <div class="quick-reactions" aria-label="Reacciones rápidas"><span>¿Qué vibra te da?</span><button type="button" data-reaction="🔥">🔥 <b>18</b></button><button type="button" data-reaction="💜">💜 <b>12</b></button><button type="button" data-reaction="🎶">🎶 <b>9</b></button></div>
                    <form id="chatForm" class="chat-form"><label for="chatInput">Habla con quienes están escuchando</label><div><input id="chatInput" maxlength="120" autocomplete="off" placeholder="Escribe un mensaje..." /><button type="submit">Enviar <span>↗</span></button></div><small>Demo visual: tus mensajes aparecen solamente en este dispositivo.</small></form>
                </aside>
            </div>
        </section>

        <section id="programacion" class="schedule-section">
            <div class="shell"><div class="section-heading"><div><p class="eyebrow">Lo que suena</p><h2>Hoy en Frekuencia</h2><p>Música durante todo el día y espacios especiales cuando prendemos los micrófonos.</p></div><div class="today"><span></span> Señal activa 24/7</div></div>
                <div class="schedule">
                    <article><time>06:00</time><div class="schedule-mark purple">AM</div><div><h3>Buenos días en Frekuencia</h3><p>Pop suave, indie y energía para comenzar</p></div><span class="status finished">Mañana</span></article>
                    <article class="current"><time>Ahora</time><div class="schedule-mark blue">NS</div><div><h3>Frekuencia Non Stop</h3><p>Selección musical sin interrupciones</p></div><span class="status live"><i class="live-dot"></i> Sonando</span></article>
                    <article><time>21:00</time><div class="schedule-mark coral">FF</div><div><h3>@programaActual</h3><p>@conductorPrincipal &amp; @segundoConductor · conversaciones e invitados</p></div><span class="status upcoming">Cuando coincidimos</span></article>
                    <article><time>23:00</time><div class="schedule-mark pink">AF</div><div><h3>After Frekuencia</h3><p>Electrónica suave y música nocturna</p></div><span class="status upcoming">Noche</span></article>
                </div>
            </div>
        </section>

        <section id="nosotros" class="about shell">
            <div class="about-graphic" aria-hidden="true"><span class="mic">●</span><div class="sound-rings"><i></i><i></i><i></i></div><small>DESDE<br />COQUIMBO<br />AL MUNDO</small></div>
            <div class="about-copy"><p class="eyebrow">Nuestra señal</p><h2>¿Qué es Frekuencia?</h2><p>Una radio musical hecha desde Coquimbo para acompañarte a cualquier hora. Y cuando tenemos algo que contar, prendemos los micrófonos, invitamos gente interesante y dejamos que la conversación nos lleve a cualquier parte.</p><blockquote>“Música todo el día.<br /><em>Conversaciones cuando coincidimos.</em>”</blockquote></div>
        </section>

        <section class="join shell"><div><p class="eyebrow">Esto se construye contigo</p><h2>Súmate a la Frekuencia</h2><p>Escucha, reacciona, pide una canción y vuelve cuando prendamos los micrófonos.</p></div><div class="social-buttons"><a href="#"><span>◎</span> Instagram</a><a href="#"><span>♪</span> TikTok</a><a href="#"><span>◖◗</span> Discord</a></div></section>
    </main>

    <footer><div class="shell footer-main"><div><a class="brand" href="#inicio"><span class="brand-symbol"><i></i><i></i><i></i><i></i><i></i></span><span>Frekuencia</span></a><p>Estamos en la misma Frekuencia.</p></div><nav><a href="#inicio">Inicio</a><a href="#programacion">Programación</a><a href="#nosotros">Nosotros</a><a href="#">Instagram</a><a href="#">Contacto</a></nav></div><div class="shell footer-bottom"><span>© 2026 Frekuencia</span><span>Radio online · Coquimbo, Chile <i></i></span></div></footer>
    <div class="mobile-player"><button id="mobilePlay" type="button" aria-label="Reproducir radio">▶</button><div><strong>Midnight Signals</strong><span>Neon Coast · EN VIVO</span></div><div class="mobile-bars"><i></i><i></i><i></i><i></i></div></div>
</div>

@section Scripts {
<script>
(() => {
    const play = document.getElementById('playButton');
    const mobilePlay = document.getElementById('mobilePlay');
    const status = document.getElementById('playerStatus');
    const togglePlayer = () => {
        const active = !play.classList.contains('playing');
        play.classList.toggle('playing', active);
        mobilePlay?.classList.toggle('playing', active);
        if (mobilePlay) mobilePlay.textContent = active ? 'Ⅱ' : '▶';
        play.setAttribute('aria-pressed', active.toString());
        play.setAttribute('aria-label', active ? 'Pausar radio' : 'Reproducir radio');
        status.textContent = active ? 'Estás escuchando Frekuencia' : 'Transmisión en pausa';
        document.querySelector('.radio-visual')?.classList.toggle('paused', !active);
    };
    play?.addEventListener('click', togglePlayer);
    mobilePlay?.addEventListener('click', togglePlayer);

    document.getElementById('likeSong')?.addEventListener('click', event => {
        const button = event.currentTarget;
        const active = button.classList.toggle('liked');
        button.firstChild.textContent = active ? '♥ ' : '♡ ';
        const count = document.getElementById('likeCount');
        count.textContent = Number(count.textContent) + (active ? 1 : -1);
    });

    document.querySelectorAll('[data-reaction]').forEach(button => button.addEventListener('click', () => {
        const count = button.querySelector('b');
        count.textContent = Number(count.textContent) + 1;
        button.classList.add('reacted');
        setTimeout(() => button.classList.remove('reacted'), 350);
    }));

    const form = document.getElementById('chatForm');
    const input = document.getElementById('chatInput');
    const messages = document.getElementById('chatMessages');
    const createChatMessage = (name, initial, text, avatarClass, extraClass = '') => {
        const template = messages?.querySelector('.message');
        if (!template) return null;
        const message = template.cloneNode(true);
        message.className = `message ${extraClass}`.trim();
        const avatar = message.querySelector('.avatar');
        avatar.className = `avatar ${avatarClass}`;
        avatar.textContent = initial;
        const paragraph = message.querySelector('p');
        paragraph.replaceChildren();
        const heading = document.createElement('strong');
        heading.append(document.createTextNode(`${name} `));
        const time = document.createElement('time');
        time.textContent = 'Ahora';
        heading.append(time);
        paragraph.append(heading, document.createTextNode(text));
        return message;
    };
    form?.addEventListener('submit', event => {
        event.preventDefault();
        const text = input.value.trim();
        if (!text) return;
        const message = createChatMessage('Tú', 'T', text, 'av-you', 'own-message');
        if (!message) return;
        messages.append(message);
        input.value = '';
        messages.scrollTo({ top: messages.scrollHeight, behavior: 'smooth' });
    });

    const demoMessages = [
        ['Vale', 'V', 'Este cambio quedó perfecto para la tarde ✨', 'av-camila'],
        ['Nico', 'N', 'Suban un poquito el volumen 🔊', 'av-pipe'],
        ['Fran', 'F', '¿Cuándo hacen programa con invitados?', 'av-sofia'],
        ['Anto', 'A', 'Temazo 💜', 'av-matias']
    ];
    let demoIndex = 0;
    setInterval(() => {
        if (document.hidden || !messages) return;
        const item = demoMessages[demoIndex++ % demoMessages.length];
        const message = createChatMessage(item[0], item[1], item[2], item[3], 'incoming');
        if (!message) return;
        messages.append(message);
        while (messages.querySelectorAll('.message').length > 9) messages.querySelector('.message').remove();
        messages.scrollTo({ top: messages.scrollHeight, behavior: 'smooth' });
        const online = document.getElementById('onlineCount');
        online.textContent = 32 + Math.floor(Math.random() * 7);
    }, 9000);
})();
</script>
}
